# Caddy terminates TLS (certificate from Let's Encrypt, renewed automatically)
# and proxies everything to the app container. WebSocket upgrades are handled
# by reverse_proxy without extra configuration.

{
	email {$ACME_EMAIL}
}

{$SITE_DOMAIN} {
	encode zstd gzip

	# Uploaded images are immutable, so let browsers keep them.
	@uploads path /uploads/*
	header @uploads Cache-Control "public, max-age=31536000, immutable"

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Third-party games run in iframes, so no frame-ancestors lockdown here.
		X-Frame-Options "SAMEORIGIN"
	}

	reverse_proxy app:3000 {
		# The live quiz holds connections open for the length of a round.
		transport http {
			read_timeout 0
		}
	}
}
