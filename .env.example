# Copy to .env and fill in. Never commit .env.

# Postgres
POSTGRES_USER=hacksite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hacksite

# Signs team session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Organiser passphrase: entered with any team name on /team, it signs in as that
# team with rights to edit and delete any team.
ADMIN_PASSPHRASE=

# Only needed when running outside Docker (npm run dev):
# DATABASE_URL=postgres://hacksite:hacksite@localhost:5432/hacksite
