# Copy to .env and fill in. Never commit .env.

# Public hostname Caddy should request a certificate for.
SITE_DOMAIN=hackathon.example.org
# Optional: address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=

# Postgres
POSTGRES_USER=hacksite
POSTGRES_PASSWORD=change-me
POSTGRES_DB=hacksite

# Signs team and organiser session cookies.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Shared passphrase for the organiser area at /de/admin.
ADMIN_PASSPHRASE=

# Only needed when running outside Docker (npm run dev):
# DATABASE_URL=postgres://hacksite:hacksite@localhost:5432/hacksite
